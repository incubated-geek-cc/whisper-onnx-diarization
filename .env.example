# Copy this file to .env and fill in the values. .env is git-ignored; never commit real keys.
# On Render, set the same names under Environment instead (no .env file there).
# None of these start with VITE_, so Vite never puts them into the web page.

# Backblaze B2 application key, limited to the models bucket.
#   On your PC (upload):  a key with read AND write access
#   On Render (download): a separate key with read-only access is enough
# The master application key does not work with the S3 API.
B2_KEY_ID=REPLACE-WITH-YOUR-KEY-ID
B2_APPLICATION_KEY=REPLACE-WITH-YOUR-APPLICATION-KEY

# Bucket name, and the Endpoint shown on the Backblaze Buckets page (with https:// in front)
B2_BUCKET=REPLACE-WITH-YOUR-BUCKET-NAME
B2_ENDPOINT=https://s3.REPLACE-WITH-YOUR-REGION.backblazeb2.com

# Folder inside the bucket that mirrors public/models
B2_PREFIX=models

# Optional. Certificate file for the AWS CLI. Leave empty: on Windows the upload script then uses
# the certificates Windows trusts, which fixes "self-signed certificate in certificate chain"
# behind a corporate proxy. Set a path only if you have a specific .pem from IT.
AWS_CA_BUNDLE=

# Where npm run models:fetch downloads from: huggingface (default, free) or b2 (this bucket;
# every download counts against B2's free allowance). With huggingface, failed files fall back to B2.
# MODELS_SOURCE=huggingface
